# Copy to .env.local for `eve dev`. On Vercel, set these in Project Settings.

# Optional full Vercel Connect GitHub connector UID. Default: github/self.
# This identifier is not a credential and does not grant access by itself.
SELF_GITHUB_CONNECTOR=

# Repository identity only; never a credential. On Vercel the repo is detected
# from VERCEL_GIT_REPO_OWNER / VERCEL_GIT_REPO_SLUG when available.
SELF_REPO=owner/name

# Optional: comma-separated principal IDs allowed to approve self-modifications.
# Empty means anyone who can reach the agent can approve.
# Slack example: slack:T012AB3CD:U045EF6GH
SELF_APPROVERS=

# Optional: force live skill loading on (1) or off (0). Default: on when deployed on Vercel.
SELF_LIVE_SKILLS=

# Operator only: expiring token scoped to the owning team's individual project.
# Project-scoped, read-only-intent: provider permits writes; our tools expose reads.
# Store server-side in Production; enable system environment variables and apply
# through the existing deployment flow. Never commit values or share in chat.
SELF_VERCEL_TOKEN=
# Automatically exposed at build/runtime on Vercel with system variables enabled.
# For local development the operator must explicitly set this and the SAME
# project's token; synthetic values are used only in tests. No team env assumed.
VERCEL_PROJECT_ID=
# Rotate: replace secret with a new same-project token, apply via deployment flow,
# verify reads, then revoke old token. Miguel/controller installs Production token.
