# Copy to .env.local for `eve dev`. On Vercel, set these in Project Settings.

# Optional full Vercel Connect GitHub connector UID. Default: github/self.
# This identifier is not a credential and does not grant access by itself.
SELF_GITHUB_CONNECTOR=

# Repository identity only; never a credential. On Vercel the repo is detected
# from VERCEL_GIT_REPO_OWNER / VERCEL_GIT_REPO_SLUG when available.
SELF_REPO=owner/name

# Optional: comma-separated principal IDs allowed to approve self-modifications.
# Empty means anyone who can reach the agent can approve.
# Slack example: slack:T012AB3CD:U045EF6GH
SELF_APPROVERS=

# Optional: force live skill loading on (1) or off (0). Default: on when deployed on Vercel.
SELF_LIVE_SKILLS=
